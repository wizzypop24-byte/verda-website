rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Profile document — only the owner can read or write it.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 200;
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 200;
      allow delete: if false;
    }

    // Consent receipt — write once, never readable from the client.
    match /consent/{docId} {
      allow create: if request.resource.data.keys().hasOnly(['analytics', 'marketing', 'ts', 'source', 'uid'])
        && request.resource.data.analytics is bool
        && request.resource.data.marketing is bool;
      allow read, update, delete: if false;
    }

    // Newsletter / quiz leads — append only.
    match /newsletter/{docId} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'consent', 'source', 'productInterest', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 200
        && request.resource.data.email.matches('.*@.*\\..*')
        && request.resource.data.consent == true;
      allow read, update, delete: if false;
    }

    // Orders — append only; a guest may create one, only the owner can read it.
    match /orders/{orderId} {
      allow create: if request.resource.data.keys().hasAll([
          'items', 'subtotal', 'shipping', 'codFee', 'discount', 'total',
          'paymentMethod', 'status', 'customer', 'uid', 'source', 'createdAt'
        ])
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 20
        && request.resource.data.total is number
        && request.resource.data.total > 0
        && request.resource.data.total <= 100000
        && request.resource.data.paymentMethod == 'cod'
        && request.resource.data.status == 'placed'
        && (request.resource.data.uid == null || request.resource.data.uid == request.auth.uid)
        && request.resource.data.customer.name is string
        && request.resource.data.customer.name.size() >= 2
        && request.resource.data.customer.phone is string
        && request.resource.data.customer.phone.size() == 10
        && request.resource.data.customer.pincode is string
        && request.resource.data.customer.pincode.size() == 6;
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Cart — private per user, mirrored from localStorage once signed in.
    match /carts/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Quiz answers — append only, readable by the owner if signed in.
    match /quiz_results/{docId} {
      allow create: if request.resource.data.picks is list
        && request.resource.data.picks.size() > 0
        && request.resource.data.picks.size() <= 3
        && (request.resource.data.uid == null || request.resource.data.uid == request.auth.uid);
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
